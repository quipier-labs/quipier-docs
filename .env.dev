# Dev stage build-time env. Injected by `npm run deploy:dev` (dotenv-cli).
# Non-secret — safe to commit. NEXT_PUBLIC_* are inlined at build.
NEXT_PUBLIC_QUIPIER_API_BASE=https://api-dev.quipier.com
NEXT_PUBLIC_QUIPIER_APP_BASE=https://app-dev.quipier.com
NEXT_PUBLIC_QUIPIER_PASSPORT_BASE=https://passport-dev.quipier.com
NEXT_PUBLIC_QUIPIER_DOCS_BASE=https://docs-dev.quipier.com
