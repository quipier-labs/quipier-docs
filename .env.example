# Cross-service URLs by SaaS stage. Copy to `.env.local` for local dev.
# Code defaults (lib/urls.ts) are PRODUCTION; `.env.dev` (deploy:dev) sets dev.
#
# local  api :8787  · app :3000 · passport :3100 · docs :5174
# dev    api-dev / dash-dev / passport-dev / docs-dev .quipier.com
# prod   api / app / passport / docs .quipier.com  (= defaults)
NEXT_PUBLIC_QUIPIER_API_BASE=http://localhost:8787
NEXT_PUBLIC_QUIPIER_APP_BASE=http://localhost:3000
NEXT_PUBLIC_QUIPIER_PASSPORT_BASE=http://localhost:3100
NEXT_PUBLIC_QUIPIER_DOCS_BASE=http://localhost:5174
