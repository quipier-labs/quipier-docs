{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quipier-docs",
  "compatibility_date": "2025-09-23",
  // Static site: Next export (`output: 'export'`) emits to ./out.
  // assets-only (no Worker). Cloudflare serves it at the domain root.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "env": {
    "dev": {
      "name": "quipier-docs-dev",
      // Auto-creates DNS + TLS on the quipier.com zone.
      "routes": [{ "pattern": "docs-dev.quipier.com", "custom_domain": true }]
    },
    "prod": {
      "name": "quipier-docs",
      "routes": [{ "pattern": "docs.quipier.com", "custom_domain": true }]
    }
  }
}
