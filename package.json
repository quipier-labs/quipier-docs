{
  "name": "quipier-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Quipier docs site (Fumadocs, static) + SDK playground — docs.quipier.com",
  "scripts": {
    "dev": "next dev --port 5174",
    "build": "next build",
    "start": "serve out",
    "preview:site": "serve out -l 5175",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "deploy:dev": "dotenv -e .env.dev -- next build && wrangler deploy --env dev",
    "deploy:prod": "dotenv -e .env.prod -- next build && wrangler deploy --env prod"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@quipier/sdk": "^0.1.1",
    "fumadocs-core": "^16.9.1",
    "fumadocs-mdx": "^15.0.9",
    "fumadocs-ui": "^16.9.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.94.0"
  },
  "engines": {
    "node": ">=20"
  }
}
