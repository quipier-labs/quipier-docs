# Prod stage build-time env. Injected by `npm run deploy:prod` (dotenv-cli) so a
# local .env.local can't leak localhost URLs into a production build.
NEXT_PUBLIC_QUIPIER_API_BASE=https://api.quipier.com
NEXT_PUBLIC_QUIPIER_APP_BASE=https://quipier.com
NEXT_PUBLIC_QUIPIER_PASSPORT_BASE=https://passport.quipier.com
NEXT_PUBLIC_QUIPIER_DOCS_BASE=https://docs.quipier.com
